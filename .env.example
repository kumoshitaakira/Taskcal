# Taskcal ローカル開発用の環境変数（雛形）
# 実値は .env.local へ置く。.env.local はコミットしない。
#
# 秘密値の扱い（ADR-008）:
#   - APIキーはサーバー側だけで読む。NEXT_PUBLIC_ を付けない。
#   - ブラウザ・モバイルクライアントへGatewayのキーを渡さない。

# --- PostgreSQL（compose.yaml の開発用DBに対応。本番の資格情報ではない） ---
DATABASE_URL=postgres://taskcal:taskcal_dev@127.0.0.1:5433/taskcal_dev

# --- OrcaRouter（ADR-007 / RFC-004） ---
# 未設定のままで起動できる。未設定時は実推論を行わず UNCONFIGURED と表示する。
# 主催指定のサービス名が別の場合に備え、base URL は差し替え可能にしている
# （docs/sources.md「サービス名」を参照）。
ORCA_BASE_URL=
ORCA_API_KEY=

# --- 費用・回数の上限（RFC-004 §7。Q10で2026-09-21に暫定確定） ---
# 金額は「USDの整数micro単位」（1 USD = 1000000）。円ではない。
# 円換算は表示時に、換算日時とレートを添えて行う。
# 空欄は「未設定」であり、0という意味ではない。未設定なら有料呼出しを開始しない。
#
#   ORCA_CASE_SPEND_LIMIT_MICRO_USD    case_spend_limit：1案件あたりの金額
#   ORCA_RUN_SPEND_LIMIT_MICRO_USD     run_spend_limit：実行全体の金額
#   ORCA_CASE_CALL_LIMIT               case_call_limit：1案件あたりの呼出し回数
#                                      未設定なら 24 を既定にする（Q10の暫定値）
#                                      24は検証前の上限候補で、十分な回数だという
#                                      保証ではない
#
# 1呼出しの費用は固定額ではなく、入力長・出力上限・単価から毎回見積もる
# （RFC-004 §7）。単価は候補モデルのうち**最も高い**ものを入れる。振り先が
# 変わっても予約が不足しないようにするため。
#
#   ORCA_INPUT_MICRO_USD_PER_KTOK      入力1000トークンあたりの単価（最大）
#   ORCA_OUTPUT_MICRO_USD_PER_KTOK     出力1000トークンあたりの単価（最大）
#   ORCA_MAX_REPLY_CHARS               返信本文の文字数上限。既定1000
#                                      超える入力は呼出さずに拒否する
#   ORCA_MAX_OUTPUT_TOKENS             出力トークン上限。既定512
#
# 例: 1案件0.50 USD、全体5.00 USD、入力0.003/Ktok、出力0.015/Ktok
#   ORCA_CASE_SPEND_LIMIT_MICRO_USD=500000
#   ORCA_RUN_SPEND_LIMIT_MICRO_USD=5000000
#   ORCA_INPUT_MICRO_USD_PER_KTOK=3000
#   ORCA_OUTPUT_MICRO_USD_PER_KTOK=15000
ORCA_CASE_SPEND_LIMIT_MICRO_USD=
ORCA_RUN_SPEND_LIMIT_MICRO_USD=
ORCA_CASE_CALL_LIMIT=
ORCA_INPUT_MICRO_USD_PER_KTOK=
ORCA_OUTPUT_MICRO_USD_PER_KTOK=
ORCA_MAX_REPLY_CHARS=
ORCA_MAX_OUTPUT_TOKENS=
