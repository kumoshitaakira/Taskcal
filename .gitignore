# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Taskcal
# ローカル環境ファイルは共有しない。雛形の .env.example だけをコミットする。
!.env.example

# CSV作業用領域（正式採用前の成果物。勤務照会へ混ぜない: RFC-010 §4）
/var/
# Claude Code のプレビュー設定。ツール固有の設定で、チームの成果物ではない。
.claude/launch.json
